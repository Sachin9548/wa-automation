generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Merchant {
  id                String   @id @default(uuid())
  brandName         String
  email             String   @unique
  phone             String   @unique
  password          String
  
  category          String   @default("ECOMMERCE") // ECOMMERCE, RESTAURANT
  totalPaidAmount   Float    @default(0.0) 
  
  // Analytics
  totalSent         Int      @default(0)
  totalRead         Int      @default(0)
  totalClicked      Int      @default(0)
  totalConverted    Int      @default(0)
  recoveredRevenue  Float    @default(0.0)

  // Business Intel
  storeUrl          String?
  productsInfo      String?
  deliveryPolicy    String?
  returnPolicy      String?

  // Admin Controls
  shopifyToken      String?
  shopifyClientId   String?   // App Client ID — for token refresh
  shopifyClientSecret String? // App Client Secret — for token refresh
  subscriptionExpiry DateTime?
  shopifySecret     String?

  // Service Control (admin manually manages — never auto-stops)
  serviceActive     Boolean  @default(true)   // admin toggle: ON = messages send, OFF = paused
  isFree            Boolean  @default(false)  // free merchant flag

  // Meta WhatsApp Cloud API credentials (set by admin per merchant)
  metaPhoneNumberId String?   // Phone Number ID from Meta app dashboard
  metaAccessToken   String?   // Permanent system user token (never expires)
  metaWabaId        String?   // WhatsApp Business Account ID

  // Plan (subscription only — Meta charges client directly)
  plan              String   @default("STARTER")

  // Statuses
  status            String   @default("PENDING_ONBOARDING")
  whatsappConnected Boolean  @default(false)
  // whatsappSessionId removed — was Baileys-only, not used with Meta Cloud API

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // 🔗 RELATIONS (All fixed and mapped properly)
  messages          Message[]
  clicks            Click[]
  customers         Customer[]
  abandonedCarts    AbandonedCart[]
  flows             AutomationFlow[]
  campaigns         Campaign[]
  payments          Payment[]
  orders            Order[]
  syncLog           SyncLog?
  trackingLinks     TrackingLink[]
  activityLogs      ActivityLog[]
}

model Message {
  id            String   @id @default(uuid())
  merchantId    String
  customerPhone String
  content       String   @db.Text
  direction     String              // INCOMING or OUTGOING
  status        String   @default("SENT") // SENT, DELIVERED, READ, FAILED
  failReason    String?             // Meta error message if failed
  templateName  String?             // which template was used
  campaignId    String?             // if part of a campaign
  cartId        String?             // if abandoned cart message

  // Media fields — populated for incoming media messages
  mediaId       String?             // Meta media ID (used to fetch URL)
  mediaType     String?             // image | video | audio | document | sticker | location
  mediaMimeType String?             // e.g. image/jpeg, audio/ogg
  mediaCaption  String?             // caption sent with image/video
  mediaFilename String?             // original filename for documents
  mediaLat      Float?              // latitude for location messages
  mediaLng      Float?              // longitude for location messages
  mediaAddress  String?             // address/name for location messages

  timestamp     DateTime @default(now())
  
  merchant      Merchant    @relation(fields: [merchantId], references: [id])
  trackingLinks TrackingLink[]
}

// Click tracking — short URL that redirects and records click
model TrackingLink {
  id            String   @id @default(uuid())
  merchantId    String
  messageId     String?             // which message this link was in
  customerPhone String
  originalUrl   String   @db.Text  // actual Shopify cart/checkout URL
  discountCode  String?             // discount code embedded in message

  clicked       Boolean  @default(false)
  clickedAt     DateTime?
  converted     Boolean  @default(false)
  convertedAt   DateTime?
  convertedRevenue Float? @default(0)  // order value when converted

  createdAt     DateTime @default(now())

  merchant      Merchant @relation(fields: [merchantId], references: [id])
  message       Message? @relation(fields: [messageId], references: [id])
}

model Click {
  id          String   @id @default(uuid())
  merchantId  String
  type        String   // ABANDONED_CART, CAMPAIGN_NAME
  linkUrl     String?  // NAYA: Kaunsi link pe click kiya
  timestamp   DateTime @default(now())
  
  merchant    Merchant @relation(fields: [merchantId], references: [id])
}

model AbandonedCart {
  id              String   @id @default(uuid())
  merchantId      String
  shopifyCartId   String   @unique  
  customerPhone   String
  customerName    String
  cartUrl         String
  totalPrice      Float
  lineItems       String?  @db.Text  // JSON: [{name, quantity, price, image}]
  status          String   @default("PENDING") // PENDING, SENT, RECOVERED, EXPIRED, FAILED
  createdAt       DateTime @default(now())
  
  merchant        Merchant @relation(fields: [merchantId], references: [id])
}

model Customer {
  id              String   @id @default(uuid())
  merchantId      String
  phone           String
  name            String?
  email           String?
  
  // Purchase history
  totalOrders     Int      @default(0)
  totalSpent      Float    @default(0.0)
  lastOrderDate   DateTime?
  firstOrderDate  DateTime?
  averageOrderValue Float  @default(0.0)

  // Shopify data
  shopifyCustomerId String?
  city            String?
  province        String?
  country         String?
  tags            String?   // comma separated

  // Customer type tracking (point 12)
  hasAbandonedCart  Boolean @default(false)
  hasPlacedOrder    Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  merchant        Merchant @relation(fields: [merchantId], references: [id])
  orders          Order[]
  
  @@unique([merchantId, phone]) 
}

model AutomationFlow {
  id            String   @id @default(uuid())
  merchantId    String
  
  type          String   // ABANDONED_CART_1, ABANDONED_CART_2, ORDER_CONFIRM
  isActive      Boolean  @default(false) 
  
  delayMinutes      Int      
  template          String   @db.Text   // display/preview text
  metaTemplateName  String?             // actual Meta approved template name e.g. "shop_now"
  metaTemplateLang  String?  @default("en_US")  // template language code e.g. "en", "en_US", "hi"
  discountCode      String?             // discount code to embed in message e.g. "VIP10"
  
  updatedAt     DateTime @updatedAt

  merchant      Merchant @relation(fields: [merchantId], references: [id])
  
  @@unique([merchantId, type]) 
}

model Campaign {
  id              String   @id @default(uuid())
  merchantId      String
  
  name            String   
  template        String   @db.Text 

  // Meta template fields
  metaTemplateName  String?           // approved Meta template name
  metaTemplateLang  String?           // e.g. "en_US", "hi"
  discountCode      String?           // optional discount code

  // Scheduling
  scheduledAt     DateTime?           // null = send immediately, set = scheduled
  
  status          String   @default("DRAFT") // DRAFT, SCHEDULED, SENDING, COMPLETED, CANCELLED
  totalRecipients Int      @default(0)
  sentCount       Int      @default(0)
  
  createdAt       DateTime @default(now())

  merchant        Merchant @relation(fields: [merchantId], references: [id])
}

// Payment records — admin manually adds when merchant pays
model Payment {
  id          String   @id @default(uuid())
  merchantId  String

  amount      Float                    // Amount received (0 for free)
  planDays    Int                      // How many days of service given
  note        String?                  // Optional note (e.g. "Diwali offer", "Free trial")
  paidAt      DateTime @default(now()) // When payment was received

  merchant    Merchant @relation(fields: [merchantId], references: [id])
}

// Shopify orders — golden data
model Order {
  id              String   @id @default(uuid())
  merchantId      String
  customerId      String?  // FK to Customer

  shopifyOrderId  String
  orderNumber     String?  // e.g. "#1001"
  totalPrice      Float    @default(0.0)
  currency        String   @default("INR")
  status          String   @default("unfulfilled") // fulfilled, unfulfilled, cancelled
  paymentStatus   String   @default("paid")         // paid, pending, refunded

  lineItems       String?  @db.Text  // JSON string of products ordered
  shippingAddress String?  @db.Text  // JSON string

  shopifyCreatedAt DateTime?
  createdAt       DateTime @default(now())

  merchant        Merchant  @relation(fields: [merchantId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])

  @@unique([merchantId, shopifyOrderId])
}

// Sync log — track last sync time per merchant (point 11)
model SyncLog {
  id          String   @id @default(uuid())
  merchantId  String   @unique  // one record per merchant
  
  lastSyncAt  DateTime @default(now())
  totalSynced Int      @default(0)
  status      String   @default("completed") // running, completed, failed
  note        String?

  merchant    Merchant @relation(fields: [merchantId], references: [id])
}

// Activity Log — who did what, when (Point 8)
model ActivityLog {
  id          String   @id @default(uuid())
  merchantId  String

  action      String   // MERCHANT_ACTIVATED | SUBSCRIPTION_EXTENDED | PAYMENT_ADDED |
                       // CAMPAIGN_LAUNCHED | CAMPAIGN_SCHEDULED | CAMPAIGN_CANCELLED |
                       // FLOW_SAVED | FLOW_TOGGLED | SERVICE_TOGGLED | MERCHANT_FREE_SET |
                       // CUSTOMER_SYNCED | FULL_SYNC | CREDENTIALS_UPDATED |
                       // TEMPLATE_CREATED | TEMPLATE_DELETED | INBOX_REPLY_SENT

  description String   @db.Text  // Human-readable: "Campaign 'Diwali 2025' launched — 342 recipients"
  metadata    String?  @db.Text  // JSON: extra structured data
  actor       String   @default("Admin")

  createdAt   DateTime @default(now())

  merchant    Merchant @relation(fields: [merchantId], references: [id])
}
